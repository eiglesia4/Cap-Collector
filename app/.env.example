# Copy to .env.local. Base URL of the CapCollector HTTP API (no trailing slash):
# the CollectorsApi stack output, or the local runner started with `npm run api:local`.
VITE_API_URL=
# Sign in with Apple, web flow (CAP-22, doc/plans/CAP-22-sign-in.md): the Services ID and its registered return
# URL (the CloudFront WebUrl of CAP-16, https). Set both or neither; empty = the sign-in screen says it is not set up.
VITE_APPLE_SERVICE_ID=
VITE_APPLE_REDIRECT_URI=
# Public HTTPS origin of the web build, no trailing slash (CAP-31): share links are <VITE_WEB_URL>/cap/<id> on the
# iPhone and the Mac. naeva/dev: https://caps.naevatec.com. Empty = the web build uses its own origin and the iPhone
# shares the text without a link.
VITE_WEB_URL=
