# direnv — versioned, NO secrets. Secrets go in .envrc.local (git-ignored).
export CAP_ROOT="$(pwd)"
export CAP_DOCS="$HOME/Library/CloudStorage/OneDrive-NaevaTec(TikalTechnologiesS.L.)/MisProyectosOneDrive/CapCollector"
export AWS_PROFILE="${AWS_PROFILE:-cap-dev}"
export AWS_REGION="${AWS_REGION:-eu-west-1}"
export CAP_INSTALLATION="${CAP_INSTALLATION:-naeva}"
export CAP_STAGE="${CAP_STAGE:-dev}"
export JIRA_SITE="naevatec.atlassian.net"
export JIRA_PROJECT="CAP"
git config core.hooksPath .githooks 2>/dev/null || true
source_env_if_exists .envrc.local
